# Zellijfield AI — copy to .env (the start scripts do this for you) and adjust.
# Paths may be relative to this folder. On Windows use forward slashes: ./models or D:/ai/models
# Never put API keys here: they are entered in the studio's Settings page and stored server-side.

# ── Compose wiring ────────────────────────────────────────────────────────────────
# Default profile when no --profile is given: mock = studio only, no GPU needed.
COMPOSE_PROFILES=mock
# Base file + GPU override. The separator is ';' so the same value works on Windows and Linux.
COMPOSE_PATH_SEPARATOR=;
COMPOSE_FILE=docker-compose.yml;docker-compose.gpu.yml

# ── Studio ────────────────────────────────────────────────────────────────────────
# 127.0.0.1 = this PC only. See SETUP.md ("LAN access") before changing it to 0.0.0.0.
ZF_BIND_ADDRESS=127.0.0.1
ZF_STUDIO_PORT=3000
# Backend whose first model is preselected in the Local studio: wan2gp | comfyui | mock
ZF_DEFAULT_BACKEND=wan2gp
# 1 = list the "Mock video (no GPU)" test model in the Local studio. Keep 0 for clients.
ZF_SHOW_MOCK=0
# Internal URLs (compose service names). Change only to use servers outside this stack.
ZF_WAN2GP_MCP_URL=http://wan2gp:7866/mcp
ZF_COMFYUI_URL=http://comfyui:8188
ZF_WAN2GP_TOOLS_URL=http://wan2gp:7867

# ── Host folders (bind-mounted) ───────────────────────────────────────────────────
ZF_DATA_DIR=./data
ZF_OUTPUTS_DIR=./data/outputs
ZF_MODELS_DIR=./models
ZF_WORKFLOWS_DIR=./workflows

# ── Wan2GP runtime ───────────────────────────────────────────────────────────────
# Memory profile (wgp.py --profile): 4 = default, 5 = fail-safe for low RAM/VRAM,
# 3 = faster when the whole model fits in VRAM
ZF_WAN2GP_PROFILE=4

# ── Image builds ──────────────────────────────────────────────────────────────────
ZF_IMAGE_TAG=local
# GPU compute capability for Wan2GP's SageAttention build:
#   8.6 = RTX 30xx · 8.9 = RTX 40xx · 12.0 = RTX 50xx (several: "8.6;8.9")
ZF_CUDA_ARCHITECTURES=8.6;8.9
ZF_WAN2GP_SAGEATTENTION=1
# Parallel compile jobs for the Wan2GP build. ~4 GB RAM each: 2 for 16 GB PCs, 4 for 32 GB+.
ZF_BUILD_JOBS=2
# ComfyUI node packs: Cosmos3 (experimental) on, MelBandRoFormer (no license upstream) off
ZF_COMFYUI_COSMOS3=1
ZF_COMFYUI_MELBAND=0
