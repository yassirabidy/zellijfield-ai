# Normalise text files; shell scripts must stay LF even on Windows checkouts (they run inside Linux containers).
* text=auto eol=lf
*.sh text eol=lf
docker/**/entrypoint.sh text eol=lf
Dockerfile text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.png binary
*.jpg binary
*.mp4 binary
