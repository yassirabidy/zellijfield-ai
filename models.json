        "audio": "none"
      },
      "comfyui": {
        "workflow": "cosmos3-super.json",
        "outputNode": "13",
        "resolutions": {
          "16:9": "832x480"
        },
        "inputs": {
          "prompt": {
            "node": "2",
            "input": "prompt"
          },
          "seed": {
            "node": "7",
            "input": "noise_seed"
          },
          "steps": {
            "node": "9",
            "input": "steps"
          },
          "image": {
            "node": "14",
            "input": "image"
          },
          "frames": [
            {
              "node": "2",
              "input": "num_frames"
            },
            {
              "node": "4",
              "input": "num_frames"
            },
            {
              "node": "15",
              "input": "length"
            }
          ],
          "width": [
            {
              "node": "2",
              "input": "width"
            },
            {
              "node": "4",
              "input": "width"
            },
            {
              "node": "15",
              "input": "width"
            }
          ],
          "height": [
            {
              "node": "2",
              "input": "height"
            },
            {
              "node": "4",
              "input": "height"
            },
            {
              "node": "15",
              "input": "height"
            }
          ]
        },
        "requiredNodes": [
          "Cosmos3Loader",
          "Cosmos3TextEncode",
          "Cosmos3ImageToVideo",
          "Cosmos3Scheduler"
        ],
        "requiredFiles": [
          "cosmos3/Cosmos3-Super-Image2Video"
        ]
      },
      "todo": [
        "Third-party nodes (RyukoMatoiFan/ComfyUI-Cosmos3); output at 16 fps (the model base_fps).",
        "Checkpoint from huggingface.co/nvidia/Cosmos3-Super-Image2Video goes in models/comfyui/cosmos3/Cosmos3-Super-Image2Video/."
      ],
      "aspectRatios": [
        "16:9"
      ],
      "defaults": {
        "steps": 35,
        "frames": 93
      }
