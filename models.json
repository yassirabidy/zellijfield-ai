    {
      "id": "skyreels-v3",
      "name": "SkyReels-V3 Audio-to-Video (talking avatar)",
      "description": "SkyReels-V3 long talking-avatar video from a portrait image and a voice clip. Served by ComfyUI (WanVideoWrapper).",
      "family": "skyreels",
      "type": "video",
      "backend": "comfyui",
      "inputs": {
        "image": "required",
        "audio": "required"
      },
      "comfyui": {
        "workflow": "skyreels-v3.json",
        "outputNode": "131",
        "inputs": {
          "prompt": {
            "node": "241",
            "input": "positive_prompt"
          },
          "negativePrompt": {
            "node": "241",
            "input": "negative_prompt"
          },
          "seed": [
            {
              "node": "317",
              "input": "seed"
            },
            {
              "node": "320",
              "input": "seed"
            }
          ],
          "image": {
            "node": "284",
            "input": "image"
          },
          "audio": {
            "node": "125",
            "input": "audio"
          }
        },
        "requiredNodes": [
          "WanVideoModelLoader",
          "WanVideoImageToVideoSkyreelsv3_audio",
          "MultiTalkWav2VecEmbeds",
          "VHS_VideoCombine",
          "ImageResizeKJv2",
          "INTConstant"
        ],
        "requiredFiles": [
          "diffusion_models/WanVideo/SkyreelsV3/Wan21-SkyReelsV3-A2V_fp8_scaled_mixed.safetensors",
          "vae/wanvideo/Wan2_1_VAE_bf16.safetensors",
          "clip_vision/clip_vision_h.safetensors",
          "text_encoders/umt5-xxl-enc-bf16.safetensors"
        ]
      },
      "todo": [
        "Output size is fixed at 1088x832 and the audio-embed length at 500 frames (nodes 245, 246, 270), as in the upstream example.",
        "The wav2vec model (TencentGameMate/chinese-wav2vec2-base) is downloaded by ComfyUI on first use."
      ]
    },
    {
      "id": "cosmos3-super",
      "name": "NVIDIA Cosmos3-Super Image-to-Video (experimental)",
      "description": "Cosmos3-Super image-to-video via third-party ComfyUI-Cosmos3 nodes. Very large model; needs ComfyUI dynamic VRAM.",
